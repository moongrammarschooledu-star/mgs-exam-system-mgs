# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/mgs_exam_system
# Alternatively, discrete vars (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=mgs_exam_system
PGUSER=postgres
PGPASSWORD=

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5000

# Future integration (Phase 12/13)
MGS_TEST_SYSTEM_API_URL=
MGS_FEE_SYSTEM_API_URL=
